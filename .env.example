# CineBook environment configuration.
# Copy this file to .env and adjust values for your machine. Never commit .env.
#
# PostgreSQL is the datasource for BOTH local development and production —
# there is no SQLite fallback anymore. Locally that's the docker-compose.yml
# container; in production (Render) it's a managed Postgres instance. The
# two configurations are called out explicitly below wherever they differ.

# --- Database ----------------------------------------------------------------
# LOCAL DEV: docker-compose.yml starts a Postgres container on host port
# 5433 (not Postgres's default 5432, to avoid colliding with any other local
# Postgres instance). Start it with `docker compose up -d`, then:
DATABASE_URL="postgresql://cinebook:cinebook@localhost:5433/cinebook"

# RENDER PRODUCTION: do NOT set this here. Render's managed PostgreSQL
# database provides its own connection string — copy it into the Render web
# service's environment variables as DATABASE_URL (Render's dashboard can
# also inject it automatically if the database and web service are linked).
# Never hardcode a production DATABASE_URL in source control or in this file.

# --- Auth / sessions -----------------------------------------------------------
# LOCAL DEV: any value works; a throwaway example is fine. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-only-insecure-secret-change-me-please-change-me"

# RENDER PRODUCTION: generate a real random secret with the command above and
# set it directly as a Render environment variable — never commit it here or
# reuse the local dev value.

# Session cookie lifetime, in seconds. 7 days default. Same for local + Render.
SESSION_TTL_SECONDS=604800

# --- Booking engine -----------------------------------------------------------
# How long a seat hold survives before automatic release, in seconds. Same
# for local + Render.
SEAT_HOLD_TTL_SECONDS=300

# --- Pricing -------------------------------------------------------------------
# Flat platform fee added per booking (cents). Same for local + Render.
BOOKING_FEE_CENTS=150
# Sales tax rate applied to (subtotal + fee), as a decimal. Same for local + Render.
TAX_RATE=0.08

# --- App -----------------------------------------------------------------------
# LOCAL DEV:
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"

# RENDER PRODUCTION: set NODE_ENV="production" and APP_BASE_URL to your
# service's public Render URL (e.g. "https://cinebook.onrender.com" — Render
# also exposes this as its own RENDER_EXTERNAL_URL variable, which you may
# reference when setting APP_BASE_URL in the Render dashboard).
#
# PORT: do not set this yourself and nothing in this app hardcodes it —
# Render injects PORT automatically, and `next start` (this app's start
# command) binds to it natively. See docs/DEPLOYMENT.md.
