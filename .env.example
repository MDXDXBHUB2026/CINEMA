# CineBook environment configuration.
# Copy this file to .env and adjust values for your machine. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local development default: SQLite file, zero setup required.
# `connection_limit=1` forces Prisma to queue concurrent writes through a
# single connection instead of opening several that fight over SQLite's file
# lock (which surfaces as raw "database is locked" errors under concurrent
# seat holds). PostgreSQL doesn't need this — see docs/BOOKING_ENGINE.md.
DATABASE_URL="file:./dev.db?connection_limit=1"
# To use PostgreSQL instead (recommended before production):
#   1. Install/run a local Postgres (or `docker compose up db`, see docker-compose.yml)
#   2. Change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
#   3. DATABASE_URL="postgresql://cinebook:cinebook@localhost:5432/cinebook"
#   4. Re-run `npm run db:migrate`

# --- Auth / sessions ----------------------------------------------------------
# Secret used to sign session JWTs (HS256). Generate your own for real use:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-only-insecure-secret-change-me-please-change-me"
# Session cookie lifetime, in seconds. 7 days default.
SESSION_TTL_SECONDS=604800

# --- Booking engine -----------------------------------------------------------
# How long a seat hold survives before automatic release, in seconds.
SEAT_HOLD_TTL_SECONDS=300

# --- Pricing -------------------------------------------------------------------
# Flat platform fee added per booking (cents).
BOOKING_FEE_CENTS=150
# Sales tax rate applied to (subtotal + fee), as a decimal.
TAX_RATE=0.08

# --- App -----------------------------------------------------------------------
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"
